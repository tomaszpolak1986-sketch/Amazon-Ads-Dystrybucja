# --- Login with Amazon (LWA) ---
ADS_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
ADS_CLIENT_SECRET=xxxxxxxx
ADS_REFRESH_TOKEN=Atzr|xxxxxxxx

# Adres zwrotny - musi byc IDENTYCZNY z wpisem na liscie
# Allowed Return URLs w Security Profile. authorize.py nasluchuje na tym porcie.
ADS_REDIRECT_URI=http://localhost:9090/redirect

# EU (DE/ES/IT/FR/UK/PL/SE/NL/TR), NA, FE
ADS_REGION=EU

# --- Dostep do panelu ---
# Ustaw komenda: python backend/scripts/cli.py setpassword
# Haslo nie jest nigdzie przechowywane - tylko jego skrot argon2.
# --- Selling Partner API: sprzedaz calkowita do TACOS ---
# Osobna aplikacja niz reklamowa - kluczy nie da sie wspoldzielic.
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_REFRESH_TOKEN=
SP_REGION=EU

# UWAGA przy docker compose: kazdy `$` w wartosci zapisz jako `$$`
# (compose interpoluje zmienne w tym pliku, a hash argon2 jest pelen `$`).
AUTH_PASSWORD_HASH=
AUTH_SECRET=
# Ciasteczko Secure wymaga HTTPS. Za reverse proxy z TLS ustaw na true.
AUTH_COOKIE_SECURE=false
# Awaryjny wylacznik - TYLKO praca lokalna, nigdy na serwerze w sieci.
AUTH_DISABLED=false
# Skad wolno wolac API (adres frontendu), po przecinku
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Automatyczne kolejkowanie ---
# Prog kosztu, powyzej ktorego regula w tle sama tworzy plan do zatwierdzenia
# Automatyczne odswiezanie danych. To wylacznie ODCZYT - pobranie raportow
# niczego w Amazonie nie zmienia, wiec nie ma tu czego zatwierdzac.
AUTO_REFRESH_ENABLED=true
AUTO_REFRESH_HOURS=6
# Okno wstecz. Amazon dopisuje konwersje z opoznieniem, wiec wczorajszy dzien
# jeszcze rosnie - dlatego pobieramy kilka dni, a nie sam ostatni.
AUTO_REFRESH_DAYS=3

AUTO_QUEUE_MIN_COST=50

# Sponsored Brands i Display - raz na dobe. Ich raporty generuja sie 20-60
# minut, wiec czestsze wolanie tylko zapycha kolejke u Amazona.
SB_SD_REFRESH_ENABLED=true
SB_SD_REFRESH_HOUR=4
SB_SD_REFRESH_DAYS=14

# --- Baza ---
# Lokalnie SQLite; na VPS: postgresql+psycopg://user:pass@host:5432/adspanel
DATABASE_URL=sqlite:///./data/adspanel.db

# --- App ---
TZ=Europe/Warsaw
LOG_LEVEL=INFO

# --- wdrozenie na serwer (nieuzywane lokalnie) ---
# Postgres dziala na hoscie, kontener siega po niego przez host.docker.internal.
# DATABASE_URL=postgresql+psycopg://panel:HASLO@host.docker.internal:5432/adspanel

# Porty na hoscie. 8000 jest zajete, stad 8010/3010.
# PANEL_API_PORT=8010
# PANEL_WEB_PORT=3010

# Adres, pod ktorym PRZEGLADARKA widzi API. Wkompilowany na stale w build
# frontendu - po zmianie trzeba przebudowac obraz web.
# PANEL_PUBLIC_API_URL=https://panel.twojadomena.pl/api

# Rynki pomijane przy pobieraniu (kody krajow po przecinku), np. TR,AE,SA
SKIP_MARKETS=

# Sufit odniesienia dla sugestii (%). Panel porownuje pozycje z MNIEJSZA z dwoch
# wartosci: srednia rynku albo ten sufit. Na rynku zdrowym nic nie zmienia,
# slaby ciagnie w dol zamiast do jego wlasnej slabej sredniej.
ACOS_CEILING=30
