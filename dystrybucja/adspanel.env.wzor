# ===================================================================
#  AdsPanel - konfiguracja panelu
#
#  Plik zawiera klucze do konta Amazon. Uprawnienia: tylko wlasciciel
#  (instaluj.sh ustawia chmod 600). Nie wysylac mailem, nie kopiowac
#  poza serwer.
#
#  Po kazdej zmianie: docker compose restart api
# ===================================================================

# --- Licencja (od dostawcy panelu) ---
LICENCJA=

# --- Amazon Ads API (kampanie) ---
ADS_CLIENT_ID=
ADS_CLIENT_SECRET=
# Uzupelnia komenda: docker compose exec api adspanel autoryzacja url / token
ADS_REFRESH_TOKEN=
# Musi byc identyczny z wpisem "Allowed Return URLs" w Security Profile
ADS_REDIRECT_URI=http://localhost:9090/redirect
ADS_REGION=EU

# --- Selling Partner API (sprzedaz calkowita, TACOS) - opcjonalnie ---
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_REFRESH_TOKEN=
SP_REGION=EU

# --- Dostep do panelu ---
# Ustawia komenda: docker compose exec api adspanel setpassword
AUTH_PASSWORD_HASH=
AUTH_SECRET=
# false = panel po http w sieci firmowej. true TYLKO za reverse proxy z HTTPS -
# po http przegladarka odrzuci wtedy ciasteczko i logowanie nie zadziala.
AUTH_COOKIE_SECURE=false
AUTH_DISABLED=false
API_DOCS=false

# --- Automatyczne pobieranie danych (wylacznie odczyt z Amazona) ---
AUTO_REFRESH_ENABLED=true
AUTO_REFRESH_HOURS=6
AUTO_REFRESH_DAYS=3
SB_SD_REFRESH_ENABLED=true
SB_SD_REFRESH_HOUR=4
SB_SD_REFRESH_DAYS=14
AUTO_QUEUE_MIN_COST=50
ACOS_CEILING=30
SKIP_MARKETS=

TZ=Europe/Warsaw
LOG_LEVEL=INFO
